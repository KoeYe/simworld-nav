    "patches": [
      {
        "target": "vlm_delivery.base.graph.Graph.shortest_path_nodes",
        "reason": "Dijkstra used id(node) \u2014 a CPython memory address \u2014 to break equal-cost ties in the priority queue. Equal-cost routes are common on a street grid, so route choice varied per process and per episode, breaking replay determinism (PLAN.md M0) and cross-process EpisodeSpec equality (PLAN.md M4). Replaced with a stable key: the node's waypoint id when present, otherwise its rounded position. Path *costs* are unchanged; only which of several equally short routes is returned becomes deterministic.",
        "original_source_sha256": "b3834bda23a9dd71fb776ab1633b6046075c94e21f14c5b15d6886cfe019bbfe",
        "applied": true
      },
      {
        "target": "vlm_delivery.base.graph.Graph.shortest_path_xy_to_node",
        "reason": "Dijkstra used id(node) \u2014 a CPython memory address \u2014 to break equal-cost ties in the priority queue. Equal-cost routes are common on a street grid, so route choice varied per process and per episode, breaking replay determinism (PLAN.md M0) and cross-process EpisodeSpec equality (PLAN.md M4). Replaced with a stable key: the node's waypoint id when present, otherwise its rounded position. Path *costs* are unchanged; only which of several equally short routes is returned becomes deterministic.",
        "original_source_sha256": "cf6b2d7d436d649777f12ba7ac2b5a9917630db79e70a4efc6817e275f52edeb",
        "applied": true
      }
    ]
  },
  "state_digest_exclusions": [
    {
      "attribute": "run_dir",
      "reason": "vlm_delivery/gym_like_interface/text_env.py:216-219 builds a per-episode output folder named `run_%Y%m%d_%H%M%S` from host wall-clock and stores its absolute path on the delivery agent. It is an artifact sink, not simulation state: nothing reads it to decide a transition, and the trajectory recorder only writes into it. It is also an absolute machine-specific path, which PLAN.md 5.1 bars from portable artifacts, so it could not appear in a cross-machine conformance hash even if it were deterministic. Tracked as M0-F3."
    },
    {
      "attribute": "start_time",
      "reason": "vlm_delivery/entities/order.py:117 declares `start_time: float = field(init=False, default_factory=time.time)`. It samples host wall-clock at Order construction, so two identical episodes never agree on it. A search of the whole DeliveryBench tree finds no read of Order.start_time -- it is written and never used, so it cannot influence a transition, a reward, or a termination. Excluding it keeps the digest a statement about simulation state instead of about when the process ran. Tracked as M0-F2; if a future revision starts reading it, the field must become sim-clock derived and this exclusion must be deleted."
    }
  ],
